{
  "name": "sync-express-pc",
  "version": "1.0.0",
  "description": "Sincronizador de portapapeles rápido",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "dotenv": "^17.4.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.syncexpress.desktop",
    "productName": "Sync Express",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sync Express",
      "include": "installer.nsh",
      "perMachine": true
    }
  }
}
